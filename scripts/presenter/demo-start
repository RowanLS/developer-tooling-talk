#!/usr/bin/env bash
# demo-start: Discard demo changes and return to the first stage.
# WARNING: Use only in the disposable rt-demo presentation checkout.
set -euo pipefail
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Error: not inside a Git repository." >&2
    exit 1
}
prepare_stage() {
    if [[ -f ".pre-commit-config.yaml" ]]; then
        echo "Preparing pre-commit hook..."
        uv run pre-commit install --install-hooks
    else
        # Stages 00–05 predate pre-commit. Remove any hook left
        # behind after visiting a later stage.
        rm -f "$(git rev-parse --git-path hooks/pre-commit)"
    fi
}
clean_demo_artifacts() {
    # Remove only known generated artefacts that can survive Git tag switches
    # because they are ignored. Deliberately preserve .venv and other local files.
    find . -type d -name '__pycache__' -prune -exec rm -rf {} +
    rm -rf .pytest_cache .ruff_cache
    rm -f figure1.png
    find src tests -depth -type d -empty -delete 2>/dev/null || true
}
clean_worktree() {
    # WARNING: deliberately discards tracked and ordinary untracked changes.
    git reset --hard
    git clean -fd
    clean_demo_artifacts
}
clean_worktree
git switch --detach 00-start
clean_demo_artifacts
prepare_stage
echo "Demo ready: 00-start"
