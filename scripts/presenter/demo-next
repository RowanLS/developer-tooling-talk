#!/usr/bin/env bash
#
# demo-next: Reset the demo repository and advance to the next demo tag.
#
# WARNING: This deliberately discards tracked and untracked changes.
# Only use it in the disposable demonstration repository.

set -euo pipefail

TAGS=(
    "00-start"
    "01-uv"
    "02-ruff"
    "03-types"
    "04-complexity"
    "05-tests"
    "06-precommit"
    "07-ci"
    "08-dependabot"
    "09-final"
)

# Ensure we're inside a Git repository.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Error: not inside a Git repository." >&2
    exit 1
}

# Determine which configured tag HEAD currently corresponds to.
current=""
for tag in "${TAGS[@]}"; do
    if [[ "$(git rev-parse HEAD)" == "$(git rev-parse "$tag^{commit}")" ]]; then
        current="$tag"
        break
    fi
done

if [[ -z "$current" ]]; then
    echo "Error: HEAD is not at one of the demo tags." >&2
    echo "Use: git switch --detach ${TAGS[0]}" >&2
    exit 1
fi

# Find the next tag.
next=""
for i in "${!TAGS[@]}"; do
    if [[ "${TAGS[$i]}" == "$current" ]]; then
        if (( i + 1 < ${#TAGS[@]} )); then
            next="${TAGS[$((i + 1))]}"
        fi
        break
    fi
done

if [[ -z "$next" ]]; then
    echo "Already at final demo stage: $current"
    exit 0
fi

echo "Demo stage:"
echo "  $current -> $next"
echo
echo "Discarding demo changes..."

git reset --hard
git clean -fd

echo "Switching to $next..."
git switch --detach "$next"

echo
echo "Now at: $next"