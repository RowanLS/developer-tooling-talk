#!/usr/bin/env bash
# demo-next: Discard demo changes and advance to the next demo tag.
# WARNING: Use only in the disposable rt-demo presentation checkout.
set -euo pipefail
TAGS=(
    "00-start"
    "01-uv"
    "02-ruff"
    "03-types"
    "04-complexity"
    "05-tests"
    "06-precommit"
    "07-ci"
    "08-dependabot"
    "09-final"
)
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Error: not inside a Git repository." >&2
    exit 1
}
clean_demo_artifacts() {
    # Remove only known generated artefacts that can survive Git tag switches
    # because they are ignored. Deliberately preserve .venv and other local files.
    find . -type d -name '__pycache__' -prune -exec rm -rf {} +
    rm -rf .pytest_cache .ruff_cache
    rm -f figure1.png
}
clean_worktree() {
    # WARNING: deliberately discards tracked and ordinary untracked changes.
    git reset --hard
    git clean -fd
    clean_demo_artifacts
}
current_commit="$(git rev-parse HEAD)"
current_index=""
for i in "${!TAGS[@]}"; do
    tag="${TAGS[$i]}"
    tag_commit="$(git rev-parse "$tag^{commit}" 2>/dev/null)" || {
        echo "Error: demo tag does not exist: $tag" >&2
        exit 1
    }
    if [[ "$current_commit" == "$tag_commit" ]]; then
        current_index="$i"
        break
    fi
done
if [[ -z "$current_index" ]]; then
    echo "Error: HEAD is not at one of the configured demo tags." >&2
    exit 1
fi
current="${TAGS[$current_index]}"
if (( current_index + 1 >= ${#TAGS[@]} )); then
    echo "Already at final demo stage: $current"
    exit 0
fi
next="${TAGS[$((current_index + 1))]}"
echo "Demo stage: $current -> $next"
echo "Discarding demo changes..."
clean_worktree
echo "Switching to $next..."
git switch --detach "$next"
clean_demo_artifacts
echo "Now at: $next"
