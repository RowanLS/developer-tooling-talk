#!/usr/bin/env bash
#
# demo-back: Reset the demo repository and return to the previous demo tag.
#
# WARNING: This deliberately discards tracked and untracked changes.
# Only use it in the disposable demonstration repository.

set -euo pipefail

TAGS=(
    "00-start"
    "01-uv"
    "02-ruff"
    "03-types"
    "04-complexity"
    "05-tests"
    "06-precommit"
    "07-ci"
    "08-dependabot"
    "09-final"
)

# Ensure we're inside a Git repository.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Error: not inside a Git repository." >&2
    exit 1
}

# Get the current commit once.
current_commit="$(git rev-parse HEAD)"

# Find which configured tag corresponds to HEAD.
current=""
current_index=""

for i in "${!TAGS[@]}"; do
    tag="${TAGS[$i]}"

    # Give a useful error if a configured tag doesn't exist.
    if ! tag_commit="$(git rev-parse "$tag^{commit}" 2>/dev/null)"; then
        echo "Error: demo tag does not exist: $tag" >&2
        exit 1
    fi

    if [[ "$current_commit" == "$tag_commit" ]]; then
        current="$tag"
        current_index="$i"
        break
    fi
done

if [[ -z "$current" ]]; then
    echo "Error: HEAD is not at one of the configured demo tags." >&2
    exit 1
fi

# Don't move before the first stage.
if (( current_index == 0 )); then
    echo "Already at first demo stage: $current"
    exit 0
fi

previous="${TAGS[$((current_index - 1))]}"

echo "Demo stage:"
echo "  $current -> $previous"
echo
echo "Discarding demo changes..."

git reset --hard
git clean -fd

echo "Switching to $previous..."
git switch --detach "$previous"

echo
echo "Now at: $previous"